{
  // Abrir VS Code en ESTA carpeta (10-Proyectos/pomodorozion) para que funcione.
  // Queda sin trackear: el .gitignore de pomodorozion ignora .vscode/
  "version": "0.2.0",
  "configurations": [
    {
      "type": "spring-boot",
      "name": "pomodorozion (TRACE security)",
      "request": "launch",
      "mainClass": "com.zion.pomodorozion.PomodorozionApplication",
      "projectName": "pomodorozion",
      "args": [
        "--logging.level.org.springframework.security=TRACE",
        "--spring.h2.console.enabled=true"
      ],
      "console": "internalConsole"
    },
    {
      "type": "spring-boot",
      "name": "pomodorozion (normal)",
      "request": "launch",
      "mainClass": "com.zion.pomodorozion.PomodorozionApplication",
      "projectName": "pomodorozion",
      "console": "internalConsole"
    }
  ]
}