# Copia este archivo como .env y rellena los valores.
#   cp .env.example .env
#
# .env esta en el .gitignore: nunca se sube al repo.

# ---- Servidor ----
PORT=3000

# ---- Base de datos ----
# El host es localhost porque el servicio MongoDB corre en tu propia maquina.
# La parte de despues del "/" es el NOMBRE de la base. Elige uno y mantenlo.
MONGO_URI=mongodb://localhost:27017/pccomponentes

# ---- Autenticacion ----
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si se filtra, alguien puede firmar tokens falsos y entrar como cualquier
# usuario. Nunca lo escribas a mano ni lo subas al repo.
JWT_SECRET=PEGA_AQUI_UN_SEGUNDO_GENERADO
JWT_EXPIRES_IN=2h
MAILJET_API_KEY=TU_API_KEY_DE_MAILJET
MAILJET_API_SECRET=TU_API_SECRET_DE_MAILJET
MAIL_FROM_EMAIL=tucorreo@ejemplo.com
FRONT_URL=http://localhost:5173
JWT_VERIFY_EXPIRES_IN=15m

# ---- Google OAuth ----
# Credenciales de Google Cloud Console (OAuth 2.0 Client ID).
# La redirect URI debe coincidir EXACTAMENTE con la registrada alli.
GOOGLE_OAUTH_CLIENT=TU_CLIENT_ID_DE_GOOGLE.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=TU_CLIENT_SECRET_DE_GOOGLE
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/Cliente/LoginGoogleCallBack
